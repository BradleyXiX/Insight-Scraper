# -----------------------------------------------------------------------------
# Insight Scraper API - Environment Configuration
# Copy to `.env` for local runs, or set the same variables in Render/Docker.
# -----------------------------------------------------------------------------

# Deployment environment. Use `production` for anything public; it disables the
# auth bypass and refuses to start if DEV_BYPASS_AUTH is set.
ENVIRONMENT=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foundry

# Browser origins allowed to call this API (comma separated).
# Production defaults to an empty list, so this must be set explicitly.
ALLOWED_ORIGINS=http://localhost:3000

# Clerk authentication. Required unless DEV_BYPASS_AUTH is enabled.
# The frontend API value looks like https://your-app.clerk.accounts.dev
CLERK_FRONTEND_API=

# Local-only auth bypass. Development only; ignored in production.
# When enabled, every request runs as DEV_TENANT_ID with no token.
DEV_BYPASS_AUTH=false
DEV_TENANT_ID=local_operator

# Stripe billing. Both values are required before the API can gate scraping.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Maximum seconds a single scrape may run before the API returns 504.
SCRAPE_TIMEOUT_SECONDS=300
